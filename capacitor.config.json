{
  "appId": "com.familydrive.app",
  "appName": "FamilyDrive",
  "webDir": "public",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://family-drive.onrender.com",
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0b0f19",
      "showSpinner": false
    },
    "Camera": {
      "permissions": ["camera", "photos"]
    },
    "Filesystem": {
      "permissions": ["publicStorage"]
    }
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  }
}
